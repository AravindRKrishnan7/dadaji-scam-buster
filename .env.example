# Which LLM backend to use: groq (default, cloud) or ollama (local, offline)
LLM_PROVIDER=groq

# Free key from https://console.groq.com/keys (also needed for voice and Prompt Guard)
GROQ_API_KEY=

# Optional per-agent model overrides (defaults live in backend/config.py)
# DADAJI_MODEL=openai/gpt-oss-120b
# ANALYST_MODEL=openai/gpt-oss-20b
# EVIDENCE_MODEL=qwen/qwen3.8-27b
# REPORTER_MODEL=openai/gpt-oss-20b
# DADAJI_REASONING_EFFORT=low     (set empty to stop sending it)
# PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# STT_MODEL=whisper-large-v3-turbo
# LLM_BASE_URL=

# Where case files are saved (SQLite). Default: data/cases.db
# DB_PATH=
